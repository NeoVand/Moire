\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {The law and the criterion, across the catalog.}\  \emph  {Top:} five of the pairs measured in Table\nonbreakingspace \ref  {tab:fringe}, rendered from their distance fields. \emph  {Bottom:} each frame low-passed to its fringe field, with the unit level sets of $D=\phi _1-\phi _2$ over it in crimson, drawn only where $r\le 1/4$. The curves come from the two index fields; the mask comes from their gradients; neither reads the image. Ordered by the fraction of the frame the criterion admits: $100.0\%$, $39.1\%$, $93.5\%$, $21.7\%$, $0.0\%$. Column\nonbreakingspace (b) is masked to a wedge because outside it the circles and the lines cross at a wide angle. Column\nonbreakingspace (d) is masked near the two centres, where the superposition is a rosette and not a fringe field at all. Column\nonbreakingspace (e) draws nothing, and there is nothing there: the criterion refuses the whole frame, and the grey panel is flat. The whole bottom row costs two gradients per pixel and no raster, which is why the tool can tell a user that a pair of layers will not interfere before it draws them.\relax }}{26}{figure.caption.67}\protected@file@percent }
\newlabel{fig:lawatlas}{{17}{26}{\figlead {The law and the criterion, across the catalog.} \emph {Top:} five of the pairs measured in Table~\ref {tab:fringe}, rendered from their distance fields. \emph {Bottom:} each frame low-passed to its fringe field, with the unit level sets of $D=\idx _1-\idx _2$ over it in crimson, drawn only where $\het \le 1/4$. The curves come from the two index fields; the mask comes from their gradients; neither reads the image. Ordered by the fraction of the frame the criterion admits: $\atlasCombs \%$, $\atlasCircleLines \%$, $\atlasHex \%$, $\atlasCircles \%$, $\atlasControl \%$. Column~(b) is masked to a wedge because outside it the circles and the lines cross at a wide angle. Column~(d) is masked near the two centres, where the superposition is a rosette and not a fringe field at all. Column~(e) draws nothing, and there is nothing there: the criterion refuses the whole frame, and the grey panel is flat. The whole bottom row costs two gradients per pixel and no raster, which is why the tool can tell a user that a pair of layers will not interfere before it draws them.\relax }{figure.caption.67}{}}
