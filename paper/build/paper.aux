\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {How wrong an undivided phase residual is.}\  For each curve family, whether the shipped shader divided by $\lVert \nabla \psi \rVert $, how many settings of that family's own sliders we swept, the worst $\lVert \nabla \psi \rVert $ found on a $1400\times 880$ frame --- which is exactly the factor by which the stroke was too thin --- and the share of the frame where the stroke was off by more than $10\%$. The parabola was correct all along; the other three were not.\relax }}{26}{table.caption.71}\protected@file@percent }
\newlabel{tab:gradient}{{8}{26}{\figlead {How wrong an undivided phase residual is.} For each curve family, whether the shipped shader divided by $\lVert \nabla \ph \rVert $, how many settings of that family's own sliders we swept, the worst $\lVert \nabla \ph \rVert $ found on a $1400\times 880$ frame --- which is exactly the factor by which the stroke was too thin --- and the share of the frame where the stroke was off by more than $10\%$. The parabola was correct all along; the other three were not.\relax }{table.caption.71}{}}
\@writefile{toc}{\contentsline {paragraph}{The spiral was wrong and looked fine.}{26}{section*.72}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The parabola was right and looks worst.}{26}{section*.73}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Thirteen families, alone and beating.}\  Each cell is one family: above, rendered by itself from its distance field; below, superposed with a perturbed copy of itself, so the fringe system sits directly under the family that generates it. The label gives the perturbation --- a rotation in degrees for families with an orientation, a multiplier on the pitch for the closed ones, which as \S  \ref  {app:catalog} explains is $r$ deciding what counts as a perturbation rather than a choice of ours. Every panel is $250$ world units across at the same stroke width; none is a crop or a resample of another. \ Three details worth a second look. The radial pencil's core is genuinely dense, and \emph  {Start} cuts a disc out of it rather than fading it. The hexagonal grid's edges are hexagon sides, computed as a support form over six normals, not three superposed line families. And the hyperbola family carries no member through the origin, because its $n=0$ level set is the degenerate asymptote pair.\relax }}{27}{figure.caption.68}\protected@file@percent }
\newlabel{fig:plate}{{18}{27}{\figlead {Thirteen families, alone and beating.} Each cell is one family: above, rendered by itself from its distance field; below, superposed with a perturbed copy of itself, so the fringe system sits directly under the family that generates it. The label gives the perturbation --- a rotation in degrees for families with an orientation, a multiplier on the pitch for the closed ones, which as \S \ref {app:catalog} explains is $\het $ deciding what counts as a perturbation rather than a choice of ours. Every panel is $250$ world units across at the same stroke width; none is a crop or a resample of another. \ Three details worth a second look. The radial pencil's core is genuinely dense, and \emph {Start} cuts a disc out of it rather than fading it. The hexagonal grid's edges are hexagon sides, computed as a support form over six normals, not three superposed line families. And the hyperbola family carries no member through the origin, because its $n=0$ level set is the degenerate asymptote pair.\relax }{figure.caption.68}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces The presets the field editor starts from, as the text a user types. Nothing here is privileged: each is parsed, compiled and unrolled down the same path any typed expression takes, and each is numerically the hand-written field it replaced rather than a lookalike.\relax }}{28}{table.caption.74}\protected@file@percent }
\newlabel{tab:exprs}{{9}{28}{The presets the field editor starts from, as the text a user types. Nothing here is privileged: each is parsed, compiled and unrolled down the same path any typed expression takes, and each is numerically the hand-written field it replaced rather than a lookalike.\relax }{table.caption.74}{}}
