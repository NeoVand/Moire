\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Raster versus field, same two families.}\  \emph  {Above:} the standard synthesis pipeline. Each layer is rasterised to a bilevel plate, the plates are multiplied, and the product is displayed at a scale that is not the one it was rasterised at --- which is what printing on transparencies and then photographing, scanning or zooming amounts to. The strokes break into dashes, the outer rings dissolve, and a coarse secondary pattern appears that is a property of the sampling grid rather than of either family. \emph  {Below:} the same two families as fields. Two distance queries per pixel, composited, at the display resolution. There is no intermediate raster, so there is nothing to alias, and the crossings stay crisp all the way to the corners.\relax }}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:traditions}{{2}{2}{\figlead {Raster versus field, same two families.} \emph {Above:} the standard synthesis pipeline. Each layer is rasterised to a bilevel plate, the plates are multiplied, and the product is displayed at a scale that is not the one it was rasterised at --- which is what printing on transparencies and then photographing, scanning or zooming amounts to. The strokes break into dashes, the outer rings dissolve, and a coarse secondary pattern appears that is a property of the sampling grid rather than of either family. \emph {Below:} the same two families as fields. Two distance queries per pixel, composited, at the display resolution. There is no intermediate raster, so there is nothing to alias, and the crossings stay crisp all the way to the corners.\relax }{figure.caption.3}{}}
